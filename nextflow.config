// Configuration shell. Included pipelines do not bring their own config, so everything the two
// pipelines expect from nextflow.config is provided here.

plugins {
    // patched nf-schema (validateParameters blocks on Channel params), see README
    id 'nf-schema@2.7.2-channel.3'
}

manifest {
    name        = 'rnaseq-diffabundance'
    version     = '0.1.0dev'
    description = 'nf-core/rnaseq composed with nf-core/differentialabundance'
    // read by the pipelines' start-up banners
    doi         = '10.5281/zenodo.1400710'
    homePage    = 'https://github.com/nf-core/rnaseq'
}

docker.enabled      = true
docker.registry     = 'quay.io'
docker.runOptions   = '-u $(id -u):$(id -g)'

process.resourceLimits = [ cpus: 4, memory: 15.GB, time: 4.h ]

// Defaults of the config params of both pipelines. Their process config reads them as top-level params.
// Names that both define take the value of the later include.
includeConfig 'pipelines/nf-core/rnaseq/conf/params.config'
includeConfig 'pipelines/nf-core/differentialabundance/conf/params.config'

// Resource labels of both pipelines
includeConfig 'pipelines/nf-core/rnaseq/conf/base.config'

// differentialabundance: DESeq2 analysis of RNA-seq counts
includeConfig 'pipelines/nf-core/differentialabundance/conf/profile/rnaseq/rnaseq.config'

params {
    study_name = 'rnaseq_diffabundance'

    // required by differentialabundance's parameter schema; outputs are published with -output-dir
    outdir = 'out'

    // differentialabundance locates its report assets relative to projectDir, which is this project
    logo_file      = "${projectDir}/pipelines/nf-core/differentialabundance/docs/images/nf-core-differentialabundance_logo_light.png"
    css_file       = "${projectDir}/pipelines/nf-core/differentialabundance/assets/nf-core_style.css"
    citations_file = "${projectDir}/pipelines/nf-core/differentialabundance/CITATIONS.md"
    report_file    = "${projectDir}/pipelines/nf-core/differentialabundance/assets/differentialabundance_report.qmd"

    // fast test analysis
    filtering_min_abundance = 10
    deseq2_vst_nsub         = 5
    seed                    = 10
}

// Process configuration of both pipelines
includeConfig 'pipelines/nf-core/rnaseq/conf/process.config'
includeConfig 'pipelines/nf-core/differentialabundance/conf/modules.config'

// Process environment that the pipelines set in their nextflow.config
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}
process.shell = ["bash", "-C", "-e", "-u", "-o", "pipefail"]
